# ============================================================
# SAIL BACKEND - PRODUCTION ENVIRONMENT (reference / template)
# ------------------------------------------------------------
# This is a TEMPLATE. Copy the values into your host's environment store
# (Render dashboard, systemd EnvironmentFile, etc.). Do NOT commit a filled-in
# copy - real `.env*` files are git-ignored by design.
#
# With the Render Blueprint (render.yaml) most of these are already defined;
# you only supply the 5 secrets marked [SECRET] below.
# ============================================================

# ---- Core ----
NODE_ENV=production
# Do NOT set PORT on Render - it injects its own PORT and routes to it.
# PORT=4000
FRONTEND_URL=https://sail.vercel.app          # your exact Vercel origin, no trailing slash
CORS_ORIGINS=                                  # extra origins, comma-separated (optional)

# ---- Database: Supabase PostgreSQL ----
# [SECRET] <SUPABASE_DB_PASSWORD> = your database password
# Region here is aws-0-ap-northeast-1 (Tokyo) for project iurbtarvbtspgmuqgfip.
DATABASE_URL=postgresql://postgres.iurbtarvbtspgmuqgfip:<SUPABASE_DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
DIRECT_URL=postgresql://postgres.iurbtarvbtspgmuqgfip:<SUPABASE_DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ---- Authentication ----
# [SECRET] Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (render.yaml generates this automatically.)
SESSION_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Bootstrap admin ----
# Leave blank in production: the super admin already exists in the database.
# Set only for a brand-new database, run `npm run create:admin` once, then clear.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Super Admin

# ---- Weather (optional) ----
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_UNITS=metric
WEATHER_CACHE_TTL_SECONDS=900

# ---- Email (optional - contact form stores messages without it) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="SAIL <no-reply@sail.local>"
CONTACT_NOTIFY_EMAIL=

# ---- Storage: Supabase Storage (required on ephemeral hosts) ----
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://iurbtarvbtspgmuqgfip.supabase.co
SUPABASE_STORAGE_BUCKET=sail-media
# [SECRET] Supabase -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# ---- Public URL of THIS API (used to build local upload URLs) ----
# [SECRET] your Render service URL, e.g. https://sail-api.onrender.com
PUBLIC_API_URL=https://sail-api.onrender.com
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=8
