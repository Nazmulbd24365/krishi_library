# ============================================================
# SHAH AGRICULTURE INFORMATION LIBRARY - BACKEND ENVIRONMENT
# Copy this file to `.env` and fill in real values.
# ============================================================

# ---- Core (REQUIRED) ----
NODE_ENV=development
PORT=4000
# Public origin of the frontend, used for CORS + secure cookies
FRONTEND_URL=http://localhost:5173
# Comma-separated list of additional allowed origins (optional)
CORS_ORIGINS=

# ---- Database: Supabase PostgreSQL (REQUIRED) ----
# Pooled connection (PgBouncer, port 6543) used by the running app.
# Append ?pgbouncer=true&connection_limit=1 for the pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) used only for migrations / introspection.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Authentication (REQUIRED) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Bootstrap admin (used once by `npm run create:admin`) ----
BOOTSTRAP_ADMIN_EMAIL=admin@sail.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Super Admin

# ---- Weather provider (OPTIONAL - app shows a safe fallback without it) ----
# open-meteo (no key required - default) | openweathermap
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_UNITS=metric
WEATHER_CACHE_TTL_SECONDS=900
# OpenWeatherMap city IDs for the 8 divisions (only needed for openweathermap)
# Dhaka=1185241, Chattogram=1205733, Rajshahi=1337233, Khulna=1337210,
# Barishal=1337227, Sylhet=1337186, Rangpur=1337166, Mymensingh=1185162

# ---- Email (OPTIONAL - contact form works without it) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="SAIL <no-reply@sail.local>"
CONTACT_NOTIFY_EMAIL=

# ---- Storage (OPTIONAL - defaults to local disk) ----
# local | supabase
# supabase = files are uploaded to Supabase Storage (requires the URL, a
#            service-role key and a PUBLIC bucket). Recommended on hosts with
#            ephemeral disks (Render, Fly, Vercel, etc.).
STORAGE_PROVIDER=local
# Local storage directory (relative to backend/) and public URL base
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=8
PUBLIC_API_URL=http://localhost:4000
# Supabase storage (only when STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sail-media
