# Frontend environment (Vite). Copy to `.env`.
#
# Base URL of the backend API.
# - Local dev: leave empty to use the Vite dev proxy ("/api/v1"), or set
#   http://localhost:4000/api/v1 to call the API directly.
# - Production (Vercel): set this to your deployed API, e.g.
#   VITE_API_URL=https://sail-api.onrender.com/api/v1
#
# After changing it, redeploy/rebuild the frontend.
VITE_API_URL=http://localhost:4000/api/v1
#
# Public site URL used for canonical links and Open Graph/Twitter images.
# Leave empty in local development; set it in Vercel for production, e.g.
#   VITE_SITE_URL=https://sail.vercel.app
VITE_SITE_URL=
