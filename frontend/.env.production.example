# Frontend production environment (Vite) - template
#
# These are PUBLIC values (they ship in the browser bundle). Never put secrets
# here.
#
# Set them in the hosting dashboard, not as a committed file:
#   Netlify -> Site configuration -> Environment variables
#   (or import from a .env file with the two lines below)
#   Vercel  -> Project -> Settings -> Environment Variables
#
# After changing them you MUST redeploy: Vite bakes them in at build time.
VITE_API_URL=https://sail-api-0pkz.onrender.com/api/v1
VITE_SITE_URL=https://krishi-library.netlify.app
